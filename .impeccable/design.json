  "narrative": {
    "northStar": "Protokoll-Handbuch",
    "overview": "The Protokoll-Handbuch makes dense technical reference feel like a working handbook. A navy register provides orientation; the white reading plane carries explanation, operations and data. Yellow marks the selected register entry, while blue commands and green events retain their precise semantic roles.\n\nThe system is compact and practical: ruled entries replace decorative card stacks, Public Sans carries prose and interface labels, and monospace distinguishes protocol data. Depth comes primarily from surface contrast and dividers. The self-hosted variable Public Sans font is shipped with its OFL license; there are no shipping raster illustrations.",
    "keyCharacteristics": [
      "Navy register and white reading plane.",
      "Yellow selected navigation; blue commands and green events.",
      "Flat ruled operations with adjacent explanation and example/schema views.",
      "Compact typography, direct keyboard paths and restrained motion."
    ],
    "rules": [
      {
        "name": "The Selected Register Rule",
        "body": "Use yellow to locate the current register entry; keep operation direction explicit in text as well as color.",
        "section": "colors"
      },
      {
        "name": "The Data Voice Rule",
        "body": "Use Public Sans for reading and controls, and monospace for protocol identifiers, paths, schemas and JSON.",
        "section": "typography"
      },
      {
        "name": "The Ruled Plane Rule",
        "body": "Keep reference operations flat and separate them with fine rules; reserve the documented shadow for the authorization dialog.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the selected register entry and the open operation consistent.",
      "Do preserve adjacent explanation and data above the split breakpoint, then stack them for narrow reading.",
      "Do retain visible focus, labeled icon actions, text direction labels and keyboard tab navigation.",
      "Do use the shipped Public Sans font and inline stroke SVG icons."
    ],
    "donts": [
      "Don't replace ruled reference entries with a decorative card grid.",
      "Don't use color alone to communicate direction, selection or required fields.",
      "Don't add reading-content entrance animation or apply the dialog shadow to ordinary reference rows."
    ]
  }
}
